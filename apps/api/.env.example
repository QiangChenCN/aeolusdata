# ===== 服务 =====
PORT=8787
NODE_ENV=development

# 项目根：**保持不设置**。后端现位于 apps/api，configuration.ts 的 resolveRepoRoot()
# 会自动向上查找「同时含 apps/ 与 services/」的目录得到仓库根，迁移前后均稳健。
# 历史教训：旧布局的 `PROJECT_ROOT=..` 在 apps/api 目录下会解析成 <repo>/apps（少一层），
# 使凭据 / 原始层缓存等路径变成 apps/apps/api/...——服务器上曾因此报「未找到风神登录凭据」。
# 仅当自动解析不适用的特殊部署，才设为仓库根**绝对路径**。
# PROJECT_ROOT=
# 任务注册表目录（tasks.json / runs / data）；现位于 apps/api/runtime/
# 相对值相对后端启动目录（apps/api/）解析，故用 “.” 表示 apps/api 自身目录
WORKBENCH_DIR=.
# Python 解释器（spawn 任务子进程；计算服务已迁至 services/compute，由 uv 管理）
PYTHON_BIN=python

# ===== 鉴权 =====
# 全局访问令牌（兼容 SSE / 跨源 iframe 走 ?token= 查询参数）
AUTH_TOKEN=change-me
# 机器令牌（Python 计算服务回访问证）：必须与 AUTH_TOKEN 完全一致（单一配置来源 = 仓库根 .env）
NEST_AUTH_TOKEN=change-me

# ===== 钉钉单点登录（可选；不配置则禁用钉钉登录，不影响账密登录）=====
# 一个「企业内部应用」的 AppKey / AppSecret / CorpId 即可同时支撑「工作台内 JSAPI 免登」
# 与「浏览器独立访问的 OAuth2 扫码登录」两条入口；两者共用同一套本地账号与会话。
# 前置条件：已开通通讯录读取权限（JSAPI 免登拿 unionid 需要）。
# 注意：DT_OAUTH_REDIRECT_URI 与前端地址都必须为 HTTPS，且 redirect_uri 须在钉钉后台
# 「登录与分享」→「回调域名」中登记。
# 推荐：这些项也可在系统设置「钉钉设置」页可视化配置并持久化（写入 apps/api/runtime/.dingtalk_sso.json），
# 无需改本文件；本处的环境变量仅作为兜底（持久化配置优先）。
DT_APP_KEY=
DT_APP_SECRET=
DT_CORP_ID=
# OAuth2 回跳地址（浏览器扫码登录用），例如 https://your-domain.com/api/auth/dingtalk/oauth-callback
DT_OAUTH_REDIRECT_URI=
# 登录成功后前端跳转基址；留空则自动取请求来源（同域部署可留空）
DT_FRONTEND_URL=
# 未绑定钉钉的账号是否自动开户（按指定角色），实现「首次访问即自动登录」。
# 留空=关闭（需先由管理员/本人绑定）；可选值如 viewer / operator。
DT_AUTO_PROVISION_ROLE=

# ===== 可插拔计算（源自 ADR-2026-09-20）=====
# FastAPI 计算服务（8900）基址；重计算一律转发给它，缺省即本机 8900
PYTHON_COMPUTE_URL=http://127.0.0.1:8900
