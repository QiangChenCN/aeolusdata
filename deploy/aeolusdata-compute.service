[Unit]
Description=Aeolusdata Compute Service (Python / FastAPI)
After=network.target aeolusdata-backend.service

[Service]
Type=simple
# 启动方式见 compute_api/main.py 顶部注释：生产用 `gunicorn -k uvicorn.workers.UvicornWorker -w 4`
WorkingDirectory=/opt/aeolusdata/services/compute
# 自愈：启动前先清掉可能残留的同端口旧进程，保证 8900 一定可绑定。
# 背景（历史故障）：单元文件变更但未 daemon-reload 时，旧进程会脱离 systemd 管控成为孤儿
# （PPID=1）继续占着 8900，新实例 bind 报 EADDRINUSE 失败 → Restart=always 每 5 秒重试，
# 曾空转 6700+ 次，且线上跑的一直是旧代码。
# 正则里的 [.] 是刻意写法：避免本条 ExecStartPre 自身的命令行被 pkill -f 匹配到而自杀。
# 正则里的 [.] 是刻意写法：避免本条 ExecStartPre 自身的命令行被 pkill -f 匹配到而自杀。
# pkill 用 `compute_api[.]main:app`（不限定 uvicorn 前缀），对 gunicorn 主/子进程同样生效。
ExecStartPre=/bin/sh -c 'pkill -f "compute_api[.]main:app" || true'
# ⚠️ venv 路径必须与 setup.sh / update.sh 中 uv sync 的位置一致（services/compute/.venv）。
#    历史故障：旧布局把 venv 建在 python/ 下，代码迁到 services/compute/ 后未同步改这里，
#    导致全新部署时 systemd 找不到解释器 → compute 服务起不来。
ExecStart=/opt/aeolusdata/services/compute/.venv/bin/python -m gunicorn -k uvicorn.workers.UvicornWorker -w 4 --bind 127.0.0.1:8900 compute_api.main:app
# 优雅停止：先 TERM 给主进程，最多等 15s，避免停服时进程残留
ExecStop=/bin/kill -TERM $MAINPID
TimeoutStopSec=15
EnvironmentFile=/opt/aeolusdata/.env
# 取数已迁到 NestJS（ADR 修订 1）：分页请求 / 反爬节奏 / 限流退避 / 会话重登
# 都在 aeolusdata-backend 侧完成，本服务只负责落盘与大数据聚合计算。
# 凭证走 NEST_AUTH_TOKEN（来自 .env），必须与后端 AUTH_TOKEN 一致，否则会被后端
# 访问闸门拒绝（401）并静默降级为 Python 本地取数 —— 表现为刷新变慢但不报错。
# 注：原 NEST_FETCH_URL（阶段 0 取数回调）已废弃 —— 全量刷新已整体原生化，阶段 0 的取数
# 与编排都在 aeolusdata-backend 内完成，本服务只通过 /api/compute/* 被调用；
# 回调基址默认 loopback（两服务同机），如需覆盖用 NEST_BASE。
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
