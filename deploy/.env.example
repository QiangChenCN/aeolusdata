# 复制到 /opt/aeolusdata/.env 并填入真实值（.env 已被 .gitignore 忽略，不会进仓库）
# 首次部署后，用 admin 登录会被强制改密；这里仅作初始口令。

WB_ADMIN_PASSWORD=CHANGE_ME_STRONG

# ---- 可选：钉钉推送（服务器跑推送类任务时需要）----
# DING_DWS_JS=/usr/lib/node_modules/dingtalk-workspace-cli/bin/dws.js
# DING_NODE_BIN=/usr/bin/node
# DING_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# ---- 可选：其他模块需要的变量（按实际填写，勿提交真实值）----
# MINIO_...
# PG_...

# ---- 取数：NestJS 与 Python 计算服务的协作（ADR 修订 1，2026-09-22）----
# 后端（NestJS，8787）的机器令牌。单一配置来源是仓库根 /opt/aeolusdata/.env（Nest 显式读取，Python 回读兜底）；
# 这里再写一份是给「计算服务回访 Nest 取数」用的，两处必须一致。
NEST_AUTH_TOKEN=<与 /opt/aeolusdata/.env 里的 AUTH_TOKEN 相同>

# 计算服务（8900）回调 NestJS 的基址。默认已指向 loopback（两服务同机，通常无需显式配置）；
# 若计算服务与后端不在同一台机器，则必须显式设置。等价变量名：NEST_BASE / DING_NEST_BASE。
# NEST_BASE=http://127.0.0.1:8787

# 注：原 `NEST_FETCH_URL`（阶段 0 取数回调地址）已废弃 —— 全量刷新已整体原生化，
# 阶段 0 的取数、编排都在 Nest 内完成，计算侧只通过 `/api/compute/*` 被调用。

# ---- 可选：OpenTelemetry 可观测（默认关闭，需显式开启）----
# 三端（NestJS / Python 计算 / 前端）统一开关；设为 true 后把 trace 上报到 Collector。
# Collector 由 otel/docker-compose.yml 在 ECS 上 `docker compose up -d` 起。
OTEL_ENABLED=false
# Collector OTLP gRPC 端点（NestJS / Python 上报用）
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# 前端由 Vite 编译期注入（走 OTLP HTTP 端点 4318）；跨域部署时改成 http://<ECS-IP>:4318
VITE_OTEL_ENABLED=false
VITE_OTEL_COLLECTOR=http://localhost:4318
