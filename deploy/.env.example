# 复制到 /opt/aeolusdata/.env 并填入真实值（.env 已被 .gitignore 忽略，不会进仓库）
# 首次部署后，用 admin 登录会被强制改密；这里仅作初始口令。

WB_ADMIN_PASSWORD=CHANGE_ME_STRONG

# ---- 可选：钉钉推送（服务器跑推送类任务时需要）----
# DING_DWS_JS=/usr/lib/node_modules/dingtalk-workspace-cli/bin/dws.js
# DING_NODE_BIN=/usr/bin/node
# DING_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# ---- 可选：其他模块需要的变量（按实际填写，勿提交真实值）----
# MINIO_...
# PG_...
