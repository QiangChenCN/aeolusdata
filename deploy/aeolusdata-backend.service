[Unit]
Description=Aeolusdata Backend (NestJS)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/aeolusdata/apps/api
# 构建产物 dist/ 由 GitHub Actions 预编译并 rsync 下发到本机；服务器仅 pnpm install --frozen-lockfile --prod 安装运行依赖后 node dist/src/main
ExecStart=/usr/bin/node dist/src/main
# 优雅停止：先 TERM 给主进程，最多等 15s，避免停服时进程残留占住 8787
ExecStop=/bin/kill -TERM $MAINPID
TimeoutStopSec=15
Environment=NODE_ENV=production
# 端口 / AUTH_TOKEN / PYTHON_COMPUTE_URL 等见仓库根 .env（/opt/aeolusdata/.env）
# —— 这是唯一配置来源：Nest 显式读它，Python 计算服务回读它兜底；这里 EnvironmentFile 注入同一份。
EnvironmentFile=/opt/aeolusdata/.env
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
