# ===== 服务 =====
PORT=8787
NODE_ENV=development

# 项目根；后端默认在上层（Python 组件已统一收进 python/）
PROJECT_ROOT=..
# 任务注册表目录（tasks.json / runs / data）；2026-09-24 起已迁至 backend/ 下
# 相对值相对后端启动目录（backend/）解析，故用 “.” 表示 backend 自身目录
WORKBENCH_DIR=.
# Python 解释器（spawn 任务子进程）
PYTHON_BIN=python

# ===== 鉴权 =====
# 全局访问令牌（兼容 SSE / 跨源 iframe 走 ?token= 查询参数）
AUTH_TOKEN=change-me

# ===== 可插拔计算（源自 ADR-2026-09-20）=====
# 计算实现切换：node | python
COMPUTE_PROVIDER=node
# 当 COMPUTE_PROVIDER=python 时，FastAPI 计算服务的基址
PYTHON_COMPUTE_URL=http://127.0.0.1:8900
