# pnpm 配置 —— 统一 monorepo 依赖解析行为
#
# node-linker=hoisted：把依赖扁平安装到仓库根 node_modules（而非默认的符号链接隔离结构），
#   等价于 npm 的平铺布局，对 NestJS / 原生模块（@napi-rs/canvas）兼容性最好，
#   也满足「依赖提升到根 node_modules」的目标；各 apps/* 下仅保留软链。
node-linker=hoisted

# 工作区：优先使用本地 workspace 包、并自动建立软链
link-workspace-packages=true
prefer-workspace-packages=true

# 自动安装 peerDependencies，放宽严格 peer 校验（NestJS 生态常见 peer 范围漂移）
auto-install-peers=true
strict-peer-dependencies=false

# 允许在当前 Node 版本下运行（避免 engine 严格拦截）
engine-strict=false

# 迁移期：旧 npm 平铺 node_modules 文件较多，链接前需批量删除，关闭确认以免非交互卡死
safe-bulk-delete=false
