# 看板运行数据（每日刷新的原始层与结果缓存，只算实时，不进版本控制）
# 说明：这些是「刷新」产物，不是源码；各环境自己刷新生成，进仓库只会让每次
#       pull 因本地改动冲突（历史数据 09-09~09-17 已一并从版本控制移除）。
backend/data/raw/
backend/logs/
pace_state.json
# 考核/看板结果缓存与运行期导出 JSON（刷新产物，各环境自行生成，不进版本控制）
# 注：backend/data/*.json 仅忽略「非点开头」的导出文件；已跟踪的 org_tree.json 与 jobs/ 不受影响。
backend/data/results/
backend/data/assessment/
backend/data/assessment-refresh-cooldown.json
backend/data/*.json

# 运行时配置（由 Nest 后端通过 UI 落盘，属于各环境本地状态）：
# 这些 *.json 是用户在「等级标准设置」里保存的活数据，绝不能进版本控制——
# 否则每次 git pull 会用仓库里的版本覆盖掉服务器上用户已保存的设置（表现为「不持久」）。
python/dashboard/standard/grade_standards.json
python/dashboard/standard/threshold_config.json
python/dashboard/standard/teams_config.json
# 旧版孤立副本（迁移后计算侧已改读 dashboard/standard/ 下的共享文件，此处不再使用）
python/analytics/threshold_config.json
python/analytics/teams_config.json
# 「标准达成设置」活数据（2026-10 起改为按月份 × 站点，替代上面的单套文件）
python/dashboard/standard/standard_grade_settings.json
# 「服务质量设置」活数据（考核项 × 周中/周末 × 天气 × t0/t60/t100 × 权重 × 分层方式）
backend/data/.service_quality_targets.json

# 调试/嗅探产物（逆向导出链路捕获，非源码；本地可保留，不进版本控制）
sniff_delivery_*.json
_sniff/

# 运行时本地状态（dataperm.py 生成的数据权限状态，每人/每月不同，不提交）
backend/data/.data_perms.json
# 看板实时配置（考核目标，本地状态，不提交）
.realtime_targets.json

# ===== 迁移收尾补充：本地状态 / 运行产物（勿提交）=====
# 根级运行日志（前端/后端/Python 的 .out/.err；*.log 只覆盖 .log 结尾，这里补 .out/.err）
.log_*.out
.log_*.err
# 根依赖与根日志目录
node_modules/
/logs/
# backend 本地状态（站点/团队/群记忆，与已忽略的 last_teams.txt/group_recent.json 同类）
backend/data/*_last.json
backend/data/recent_groups.json
backend/*.out
# python 运行日志与生成文档
python/logs/
python/**/*.err
# 任务产物（运行期生成，非源码）：backend/data/jobs/**/out/
backend/data/jobs/**/out/
# 仓库根的 Nest 启动重定向日志（run<port>.out/.err；上面 backend/*.out 只覆盖 backend/ 目录）
/run*.out
/run*.err

# 不满意单看板运行期数据库（violation.db=月累计 / realtime.db=实时）
# 各环境自行生成（每日 03:00 回补 / 点刷新写入），绝不提交；
# 否则服务器 git pull 会因本地库与仓库版本不同而起冲突。
# （根级 data/ 已于 2026-10 迁至 backend/data：原始层 raw/ 与持久库 db/ 见上）
*.db
*.db-wal
*.db-shm
